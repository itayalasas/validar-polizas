# Azure AD OAuth Configuration
VITE_AUTH_TOKEN_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token
VITE_CLIENT_ID=your_client_id_here
VITE_CLIENT_SECRET=your_client_secret_here
VITE_GRANT_TYPE=client_credentials
VITE_SCOPE=api://YOUR_CLIENT_ID/.default

# Sura API Configuration
VITE_API_BASE_URL=https://your-api-url-here.com/api/endpoint

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
